{
  "description": "regency hooks: triggers only, every one runs a stdlib script in scripts/ (library/hooks.md). Guards: push to main, hazardous shell (asks unless a grant of the Regent's covers it: judge.py), acts/.scope/lock/banned names/grant stores, the Judge's pop-up. Recorders: lineage (fingerprint + STALE), checkpoint journal, resume slice, Regent verbs, governance routing (gov.py), shortcuts state block (shortcuts.py), pack dispatcher (the hooks of the packs active in a project, once the Regent ratified them: packs.py).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-resume.py\"", "timeout": 10, "statusMessage": "regency: resume slice"},
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-packs.py\"", "timeout": 120}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-verbs.py\"", "timeout": 5},
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-packs.py\"", "timeout": 120}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "if": "Bash(git *)", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-push.py\"", "timeout": 15, "onFailure": "block"},
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-hazard.py\"", "timeout": 10, "onFailure": "block"}
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {"type": "command", "if": "PowerShell(git *)", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-push.py\"", "timeout": 15, "onFailure": "block"},
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-hazard.py\"", "timeout": 10, "onFailure": "block"}
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-acts-guard.py\"", "timeout": 10, "onFailure": "block"}
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-judge.py\"", "timeout": 10, "onFailure": "block"}
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-packs.py\"", "timeout": 120}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-lineage.py\"", "timeout": 15},
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-journal.py\"", "async": true}
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-gov.py\"", "timeout": 10}
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-journal.py\"", "async": true}
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-judge.py\"", "timeout": 10}
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-packs.py\"", "timeout": 120}
        ]
      }
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-journal.py\"", "async": true}, {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-gov.py\"", "timeout": 10}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-journal.py\"", "async": true}]}
    ],
    "TaskCreated": [
      {"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-journal.py\"", "async": true}]}
    ],
    "TaskCompleted": [
      {"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-journal.py\"", "async": true}]}
    ],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-journal.py\"", "timeout": 10},
                 {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-packs.py\"", "timeout": 60}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-journal.py\"", "timeout": 2},
                 {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-shortcuts.py\"", "timeout": 2},
                 {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-packs.py\"", "timeout": 30}]}
    ]
  }
}
